; $VER: Install-Folio 0.1.2 (28.10.2026)
;
; Installer script for Folio, the PDF viewer and editor (Commodore's Installer 43 or later, or AROS's).
; Started from its icon (default tool Installer). It installs or updates Folio in a drawer of your
; choosing, or removes it.
;
; Installs:  <where you choose>/Folio: the program, README.md, the Fonts and TrueType drawers,
;            the example documents (optional) and the source code (optional), all with their
;            icons; the Folio drawer gets Folio's own icon. The example documents' icons are set
;            to open in the Folio just installed.
; Keeps:     your settings (Folio.prefs) when updating.
; Needs:     a 68040 or better, MUI 3.8 or later (muimaster.library 19).
;
; The script runs in the drawer it was unpacked into (Folio/), so its sources are relative to that.
; Texts carry their own line breaks (AROS's Installer doesn't wrap them), and function names are
; in lower case (AROS's Installer doesn't know "IN", only "in").

(set @app-name "Folio")
(set #version "0.1.2")

; ------------------------------------------------------------------ install or remove

(set #mode
  (askchoice
    (prompt "Do you want to install Folio,\nor remove an installed copy?")
    (help "Install or update: copies Folio into a drawer of\n"
          "your choosing. Installing over an older Folio updates\n"
          "it and keeps your settings (Folio.prefs) and the files\n"
          "opened lately.\n\n"
          "Remove: deletes an installed Folio drawer, settings\n"
          "and all. Your documents are not touched unless you\n"
          "saved them inside the Folio drawer.")
    (choices "Install or update" "Remove")
    (default 0)))

(if (= #mode 1)
(
  ; ---------------------------------------------------------------- remove
  (set #old
    (askdir
      (prompt "Which Folio drawer should be removed?")
      (help "Choose the Folio drawer itself: the one holding\n"
            "the Folio program and its Fonts drawer.")
      (default (if (exists "Work:Folio" (noreq)) "Work:Folio" "SYS:"))))
  ; only a drawer that really is Folio's
  (if (not (and (exists (tackon #old "Folio")) (exists (tackon #old "Fonts/QuillSans.font"))))
    (abort (cat "\"" #old "\"\n"
                "doesn't look like a Folio drawer (there is no\n"
                "Folio program with a Fonts drawer in it),\n"
                "so nothing was removed.")))
  (if (askbool
        (prompt (cat "Delete the whole drawer\n\n" #old "\n\n"
                     "with everything in it, including your Folio\n"
                     "settings and any documents saved there?"))
        (help "This can't be undone. Move any documents you\n"
              "want to keep out of the drawer first.")
        (default 0))
  (
    (set #parentinfo (cat #old ".info"))
    (run (cat "C:Delete >NIL: \"" #old "\" ALL QUIET FORCE"))
    (if (exists #parentinfo (noreq)) (delete #parentinfo))
    (exit "Folio has been removed." (quiet))
  )
  (exit "Nothing was removed." (quiet)))
))

; ------------------------------------------------------------------ checks

(set #cpu (database "cpu"))
(if (or (= #cpu "68000") (= #cpu "68010") (= #cpu "68020") (= #cpu "68030"))
  (if (not (askbool
             (prompt (cat "This Amiga has a " #cpu " processor.\n"
                          "Folio is built for a 68040 or better\n"
                          "and will not run on it.\n\n"
                          "Install anyway (for another Amiga, say)?"))
             (help "Folio uses the 68040's instructions and its\n"
                   "floating-point unit for drawing pages. An\n"
                   "accelerator card with a 68040 or 68060 is needed.")
             (default 0)))
    (abort "Folio was not installed.")))

(set #mui 0)
(if (exists "LIBS:muimaster.library" (noreq))
  (set #mui (/ (getversion "LIBS:muimaster.library") 65536)))
(if (< #mui 19)
  (if (not (askbool
             (prompt (if (= #mui 0)
                       (cat "MUI isn't installed (there is no\n"
                            "LIBS:muimaster.library).\n\n"
                            "Folio needs MUI 3.8 or later. Install\n"
                            "Folio anyway and add MUI afterwards?")
                       (cat "The MUI installed (muimaster.library " #mui ")\n"
                            "is older than Folio needs (version 19,\n"
                            "MUI 3.8).\n\n"
                            "Install Folio anyway and update MUI\n"
                            "afterwards?")))
             (help "MUI is the user interface system Folio is built\n"
                   "with. It is on Aminet (dev/gui/mui38usr.lha) and\n"
                   "at muidev.de (MUI 5). AROS and MorphOS have it\n"
                   "built in.")
             (default 1)))
    (abort "Folio was not installed.")))

; ------------------------------------------------------------------ where

(set #where
  (askdir
    (prompt "Where should Folio go? A drawer called \"Folio\"\n"
            "is made there (or updated, if it is there already).")
    (help "Choose the drawer or disk to put Folio in, for\n"
          "example Work:. Folio goes into a drawer of its own,\n"
          "Folio, inside the one you choose. If an older Folio\n"
          "is there, it is updated and your settings are kept.")
    (default (if (exists "Work:" (noreq)) "Work:" "SYS:"))
    (disk)))
(set #dest (tackon #where "Folio"))
(set @default-dest #dest)

(set #update (exists (tackon #dest "Folio") (noreq)))

; the parts
(set #parts
  (askoptions
    (prompt "Which parts should be installed?")
    (help "Folio itself (the program, its screen fonts and\n"
          "the stand-in fonts for PDFs) is always installed.\n\n"
          "Example documents: sample PDFs showing\n"
          "what Folio can do (a few KB).\n\n"
          "Source code: Folio's C source, for programmers\n"
          "(about 1 MB).")
    (choices "Example documents" "Source code")
    (default 1)))

; ------------------------------------------------------------------ copy

; the same drawer it was unpacked in: nothing to copy, only the icons to point at it
(set #here (expandpath ""))
(set #same (if (exists #dest (noreq)) (= (expandpath #dest) #here) 0))

(if (not #same)
(
  (if (not (exists #dest (noreq)))
    (makedir #dest
      (prompt "Making the Folio drawer")
      (help @makedir-help)))
  ; the drawer's own icon (next to the unpacked drawer), else a plain one
  (if (exists "/Folio.info" (noreq))
    (copyfiles (source "/Folio.info") (dest #where) (nogauge))
    (if (not (exists (cat #dest ".info") (noreq)))
      (run (cat "C:Copy >NIL: \"ENVARC:Sys/def_drawer.info\" \"" #dest ".info\""))))

  (complete 5)
  (copyfiles
    (prompt "Copying Folio")
    (help @copyfiles-help)
    (source "Folio")
    (dest #dest)
    (infos))
  (copyfiles
    (source "README.md")
    (dest #dest)
    (infos)
    (nogauge))
  (complete 10)
  (copyfiles
    (prompt "Copying Folio's screen fonts")
    (help @copyfiles-help)
    (source "Fonts")
    (dest (tackon #dest "Fonts"))
    (all))
  (if (exists "Fonts.info" (noreq)) (copyfiles (source "Fonts.info") (dest #dest) (nogauge)))
  (complete 55)
  (copyfiles
    (prompt "Copying the stand-in fonts for PDFs")
    (help @copyfiles-help)
    (source "TrueType")
    (dest (tackon #dest "TrueType"))
    (all))
  (if (exists "TrueType.info" (noreq)) (copyfiles (source "TrueType.info") (dest #dest) (nogauge)))
  (complete 80)
  (complete 85)

  (if (in #parts 0)
    (copyfiles
      (prompt "Copying the example documents")
      (help @copyfiles-help)
      (source "")
      (dest #dest)
      (pattern "#?.pdf")
      (infos)))
  (complete 90)
  (if (in #parts 1)
  (
    (copyfiles
      (prompt "Copying the source code")
      (help @copyfiles-help)
      (source "Source")
      (dest (tackon #dest "Source"))
      (all))
    (if (exists "Source.info" (noreq)) (copyfiles (source "Source.info") (dest #dest) (nogauge)))
  ))
))

; ------------------------------------------------------------------ icons

; the example documents open in the Folio just installed
(set #tool (tackon #dest "Folio"))
(foreach #dest "#?.pdf"
  (if (exists (tackon #dest (cat @each-name ".info")) (noreq))
    (tooltype
      (dest (tackon #dest @each-name))
      (setdefaulttool #tool))))
(complete 100)

(exit
  (cat "Folio " #version " is "
       (if #same "ready in" (if #update "updated in" "installed in"))
       "\n\n" #dest "\n\n"
       "Double-click the Folio icon to start it, or a\n"
       "PDF whose icon has Folio as its default\n"
       "tool. README.md tells you what it can do and\n"
       "how to use it."))
